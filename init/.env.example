# Copy this file to `.env` (same folder) and fill in EDMS_HOST_PATH
# before running `docker compose up`.
#
# EDMS_HOST_PATH is the directory on YOUR machine where EDMS keeps all
# its data — collections, request/response history, everything under
# storage/. Per Ravi (2026-09-14):
#   - Create this directory yourself. The app will not create it for you.
#   - It must be OUTSIDE this repo (not inside init/, not anywhere under
#     the cloned edms/ folder).
#
# Example (adjust to your machine):
#   EDMS_HOST_PATH=/home/yourname/edms-data
#   EDMS_HOST_PATH=C:\Users\yourname\edms-data
#
# Leaving this unset is deliberate — `docker compose up` will refuse to
# start with a clear error pointing back here, rather than silently
# using somewhere you didn't choose.

EDMS_HOST_PATH=
